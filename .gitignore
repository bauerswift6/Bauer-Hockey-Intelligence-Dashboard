# Transient artifacts from the scheduled contract refresh (data/fetch_contracts.py).
# The snapshot itself (data/contracts_current.json) IS committed as a seed so the
# dashboard works immediately on a fresh deploy before the first refresh runs.
data/.contracts_refresh.lock
data/contracts_current.json.tmp

# Python bytecode
__pycache__/
*.pyc

# Archetypes module raw per-game PBP cache (resumable, not for VCS)
archetypes/data/raw/
archetypes/data/*.parquet

# Large rebuildable pipeline intermediates (not read at runtime)
model/shots_enriched_*.parquet
model/xg_features_*.parquet
model/rapm_stints_*.parquet
model/shots_xg_*.parquet
model/shifts_supplement_*.parquet
model/shifts_dataset.parquet
